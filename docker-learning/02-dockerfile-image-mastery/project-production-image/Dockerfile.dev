# ==============================================================================
# 🐳 Dockerfile.dev: Development-Optimized Container
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# In development, we install ALL dependencies (including dev tools like nodemon)
COPY package*.json ./
RUN npm install

# In development, code is usually mounted via bind-mount (-v), but we copy as fallback
COPY . .

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000

# Run with nodemon for live hot-reload inside the container
CMD ["npx", "nodemon", "server.js"]
