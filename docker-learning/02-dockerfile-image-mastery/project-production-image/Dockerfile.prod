# ==============================================================================
# 🐳 Dockerfile.prod: Multi-Stage Production-Grade Container
# ==============================================================================

# ------------------------------------------------------------------------------
# STAGE 1: Builder (Temporary environment for dependency resolution & compilation)
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install ONLY production dependencies in a clean, reproducible state
RUN npm install --omit=dev

# ------------------------------------------------------------------------------
# STAGE 2: Runner (Minimal, secure production runtime)
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner

# Install dumb-init: A lightweight init system that handles PID 1 signals (SIGTERM/SIGINT)
# This allows graceful shutdowns when orchestrators like Docker, AWS ECS, or Kubernetes stop the pod
RUN apk add --no-cache dumb-init

WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV PORT=3000

# Copy node_modules directly from Stage 1 (builder) - NO NPM/DEV DEPENDENCIES INCLUDED!
COPY --from=builder /app/node_modules ./node_modules

# Copy application code with ownership assigned to non-root 'node' user
COPY --chown=node:node . .

# SECURITY BEST PRACTICE: Switch from root to unprivileged 'node' user
# If attacker compromises the app, they CANNOT gain root access inside the container
USER node

EXPOSE 3000

# Use dumb-init as entrypoint to properly forward OS signals to Node process
ENTRYPOINT ["dumb-init", "--"]

CMD ["node", "server.js"]
